# Point Claude Code at a local Anthropic-compatible server (Splash, Strata and llama-server all serve /v1/messages).
# Defaults: Splash on :8000 serving the model as "local" (configs/splash/). For Strata's agent setup use
# http://127.0.0.1:8091 and the model id inkling-2-mini-sq-15.
# Usage: set -a; . configs/agents/claude-code.env; set +a; claude
ANTHROPIC_BASE_URL=http://127.0.0.1:8000
ANTHROPIC_API_KEY=local
ANTHROPIC_MODEL=local
ANTHROPIC_DEFAULT_HAIKU_MODEL=local
ANTHROPIC_DEFAULT_SONNET_MODEL=local
ANTHROPIC_DEFAULT_OPUS_MODEL=local
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
DISABLE_TELEMETRY=1
