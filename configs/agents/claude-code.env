# Point Claude Code at a local Anthropic-compatible server (Strata and llama-server both serve /v1/messages).
# Usage: set -a; . configs/agents/claude-code.env; set +a; claude
ANTHROPIC_BASE_URL=http://127.0.0.1:8091
ANTHROPIC_API_KEY=local
ANTHROPIC_MODEL=inkling-2-mini-sq-15
ANTHROPIC_DEFAULT_HAIKU_MODEL=inkling-2-mini-sq-15
ANTHROPIC_DEFAULT_SONNET_MODEL=inkling-2-mini-sq-15
ANTHROPIC_DEFAULT_OPUS_MODEL=inkling-2-mini-sq-15
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
DISABLE_TELEMETRY=1
